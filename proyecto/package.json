{
  "name": "monedero",
  "version": "1.0.0",
  "private": true,
  "description": "API y CLI de gastos personales: el proyecto guía de Nodo.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "monedero": "./bin/monedero.js"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:cluster": "node --env-file-if-exists=.env src/cluster.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "cli": "node --env-file-if-exists=.env bin/monedero.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "typecheck": "tsc -p jsconfig.json",
    "start:secure": "node --permission --allow-fs-read=. --allow-fs-write=./data --allow-worker --env-file-if-exists=.env src/server.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
