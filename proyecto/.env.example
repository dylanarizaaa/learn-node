# Copia este archivo como .env y ajusta los valores:  cp .env.example .env
NODE_ENV=development
PORT=3000
DATABASE_PATH=data/monedero.db

# Secreto para firmar los JWT (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=2h

LOG_LEVEL=info
CURRENCY=USD

# Proxies de confianza delante de la app (Nginx, Caddy, el balanceador de tu plataforma).
# 0 si la app recibe las conexiones directamente.
TRUST_PROXY=0

# Usuario por defecto para la CLI (bin/monedero.js)
MONEDERO_USER=
